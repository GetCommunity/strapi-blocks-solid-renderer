{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SolidJs Library TSConfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "newLine": "LF",
    "allowJs": false,
    "sourceMap": true,
    "isolatedModules": true,
    "types": [
      "@testing-library/jest-dom/vitest",
      "vite/client",
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "./tests/**/*.ts",
    "./tests/**/*.tsx",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "tsup.config.ts",
    "eslint.config.mjs",
    "prettier.config.js"
  ],
  "exclude": [
    "node_modules/",
    "build/",
    "dist/",
    "scripts/",
    "public/",
    ".wrangler/",
    ".vinxi/",
    ".vercel/",
    ".tmp/",
    ".vscode"
  ]
}
