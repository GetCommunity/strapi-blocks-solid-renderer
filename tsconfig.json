{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "./tests/**/*.ts",
    "./tests/**/*.tsx",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "tsup.config.ts",
    "eslint.config.mjs",
    ".prettierrc.mjs"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "newLine": "LF",
    "allowJs": false,
    "sourceMap": true,
    "isolatedModules": true,
    "types": [
      "solid-js",
      "vite/client",
      "node",
      "@testing-library/jest-dom",
      "vitest/globals"
    ],
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules/",
    "build/",
    "dist/",
    "scripts/",
    "public/",
    ".wrangler/",
    ".vinxi/",
    ".vercel/",
    ".tmp/",
    ".vscode"
  ]
}
