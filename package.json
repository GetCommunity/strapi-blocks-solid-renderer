{
  "name": "@getcommunity/strapi-blocks-solid-renderer",
  "version": "1.0.27-next.5",
  "description": "",
  "bugs": {
    "url": "https://github.com/GetCommunity/strapi-blocks-solid-renderer/issues"
  },
  "repository": {
    "url": "https://github.com/GetCommunity/strapi-blocks-solid-renderer"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Get Community, Inc.",
    "email": "joey@getcommunity.com",
    "url": "https://www.getcommunity.com"
  },
  "maintainers": [
    {
      "name": "Joey Grable",
      "email": "joey@getcommunity.com",
      "url": "https://www.getcommunity.com"
    }
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf .turbo node_modules dist",
    "test": "vitest --run",
    "build": "tsdown",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.46",
    "@solidjs/web": "^2.0.0-rc.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "solid-js": "^2.0.0-rc.11",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "unplugin-solid": "^2.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.11",
    "solid-js": "^2.0.0-rc.11"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  }
}
