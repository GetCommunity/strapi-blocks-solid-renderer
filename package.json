{
  "name": "@getcommunity/strapi-blocks-solid-renderer",
  "version": "1.0.23-next.2",
  "description": "",
  "bugs": {
    "url": "https://github.com/GetCommunity/strapi-blocks-solid-renderer/issues"
  },
  "repository": {
    "url": "https://github.com/GetCommunity/strapi-blocks-solid-renderer"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Get Community, Inc.",
    "email": "joey@getcommunity.com",
    "url": "https://www.getcommunity.com"
  },
  "maintainers": [
    {
      "name": "Joey Grable",
      "email": "joey@getcommunity.com",
      "url": "https://www.getcommunity.com"
    }
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf .turbo node_modules dist",
    "test": "vitest --run",
    "build": "tsup",
    "format": "prettier --write ./src/**/*",
    "lint": "eslint ./src/**/*",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@getcommunity/config-prettier": "^0.1.8",
    "@getcommunity/config-typescript": "^0.0.27-next.2",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-preset-solid": "2.0.0-rc.2",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^10.7.0",
    "eslint-plugin-solid": "^0.18.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "solid-js": "2.0.0-rc.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.8",
    "solid-js": "^2.0.0-rc.8"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  }
}
